{
  "name": "lanyard-studio",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/lanyardstudio NEXT_PUBLIC_SITE_URL=https://eunhyeokjung.github.io/lanyardstudio/ next build",
    "build:cloudflare-pages": "STATIC_EXPORT=true NEXT_PUBLIC_SITE_URL=https://lanyardstudio.silverhyeok.dev/ next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "^8.2.1",
    "wrangler": "^4.114.0"
  },
  "type": "module",
  "description": "Open-source browser-based lanyard badge design and print studio",
  "license": "MIT",
  "author": {
    "name": "EunHyeokJung",
    "email": "silverhyeok.dev@gmail.com",
    "url": "https://github.com/EunHyeokJung"
  },
  "homepage": "https://lanyardstudio.silverhyeok.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EunHyeokJung/lanyardstudio.git"
  },
  "bugs": {
    "url": "https://github.com/EunHyeokJung/lanyardstudio/issues"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
