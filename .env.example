# Optional GA4 web stream measurement ID. Analytics stays disabled when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Use the same GA4 measurement ID across services and give each one a stable name.
NEXT_PUBLIC_ANALYTICS_SERVICE_NAME=lanyardstudio

# Override for local previews or alternate production hosts when needed.
NEXT_PUBLIC_SITE_URL=https://lanyard-studio.com/
